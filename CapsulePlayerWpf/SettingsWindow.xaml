<Window x:Class="CapsulePlayerWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capsule Player Settings" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White" FontFamily="Segoe UI"
        Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        <CheckBox x:Name="LockCheckBox" Content="Lock Player Position" Foreground="White" Margin="0,0,0,15" Checked="LockCheckBox_Changed" Unchecked="LockCheckBox_Changed"/>
        <TextBlock Text="Display Level" Foreground="White" Margin="0,0,0,5"/>
        <ComboBox x:Name="ZOrderComboBox" Margin="0,0,0,10" SelectionChanged="ZOrderComboBox_SelectionChanged">
            <ComboBoxItem Content="Always on Top"/>
            <ComboBoxItem Content="On Desktop"/>
        </ComboBox>
        <CheckBox x:Name="HideOnFullscreenCheckBox" Content="Hide on Fullscreen" Foreground="White" Margin="0,0,0,15" Checked="HideOnFullscreenCheckBox_Changed" Unchecked="HideOnFullscreenCheckBox_Changed"/>
        <TextBlock Text="Player Scale/Size" Foreground="White" Margin="0,0,0,5"/>
        <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Value="1.0" Margin="0,0,0,20" ValueChanged="ScaleSlider_ValueChanged" AutoToolTipPlacement="TopLeft"/>
        <Button Content="Refresh Connection" Background="#333" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,10" Click="RefreshButton_Click"/>
        <Button Content="Restore to default" Background="#333" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,10" Click="RestoreDefaultButton_Click"/>
        <Button Content="Exit Player entirely" Background="#C02020" Foreground="White" BorderThickness="0" Padding="10" Click="ExitButton_Click"/>
    </StackPanel>
</Window>
