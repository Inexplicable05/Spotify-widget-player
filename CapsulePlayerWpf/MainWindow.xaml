<Window x:Class="CapsulePlayerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CapsulePlayerWpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="Capsule Player" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" MouseDown="Window_MouseDown"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#33FFFFFF" CornerRadius="2" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="White" CornerRadius="2" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Width="600" Margin="20,10,20,30">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="AppScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>
        
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Capsule Player"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Settings" Click="MenuItemSettings_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="MenuItemExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border CornerRadius="16" Background="#C0141414" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.5" />
            </Border.Effect>
            
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                
                <!-- Album Art -->
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Image x:Name="AlbumArtImage" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,56,56" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>
                </Border>
                
                <!-- Track Info -->
                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="To be built" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" Text="No media data available yet" Foreground="#B3B3B3" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                
                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button x:Name="BtnPrev" Width="40" Height="40" Click="BtnPrev_Click" BorderThickness="0" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#14FFFFFF" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M19,6L11,12L19,18V6M11,6L3,12L11,18V6Z" Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="BtnPlayPause" Width="40" Height="40" Click="BtnPlayPause_Click" BorderThickness="0" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#14FFFFFF" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path x:Name="PlayPauseIcon" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="BtnNext" Width="40" Height="40" Click="BtnNext_Click" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#14FFFFFF" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M5,6L13,12L5,18V6M13,6L21,12L13,18V6Z" Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
                
                <!-- Progress -->
                <Slider x:Name="ProgressSlider" Grid.Column="3" VerticalAlignment="Center" Minimum="0" Maximum="100" Style="{StaticResource ModernSliderStyle}" PreviewMouseDown="ProgressSlider_PreviewMouseDown" PreviewMouseUp="ProgressSlider_PreviewMouseUp" />
            </Grid>
        </Border>
    </Grid>
</Window>
