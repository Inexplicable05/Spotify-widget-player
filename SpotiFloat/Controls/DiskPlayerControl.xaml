<local:PlayerControlBase x:Class="SpotiFloat.Controls.DiskPlayerControl"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:SpotiFloat.Controls"
                         mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/PlayerResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Width="240"
          Height="240"
          Background="Transparent"
          MouseEnter="OnMouseEnter"
          MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="ArcCanvas_MouseDown"
          MouseLeftButtonUp="ArcCanvas_MouseUp"
          MouseMove="ArcCanvas_MouseMove">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="PlayerScale" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <Ellipse Width="220"
                 Height="220"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource AppBackground}">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="{DynamicResource WindowShadowOpacity}"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid x:Name="DiscGrid"
              Width="220"
              Height="220"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.Clip>
                <EllipseGeometry Center="110,110" RadiusX="110" RadiusY="110"/>
            </Grid.Clip>

            <Border Background="{DynamicResource AlbumArtBackground}"/>

            <Image x:Name="AlbumArtImage"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform x:Name="AlbumRotate" Angle="0"/>
                </Image.RenderTransform>
            </Image>

            <Ellipse x:Name="HoverOverlay"
                     Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A8000000" Offset="0.35"/>
                        <GradientStop Color="#66000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Canvas x:Name="WaveformCanvas"
                    Width="154"
                    Height="58"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"/>

            <Grid x:Name="HoverGroup"
                  Opacity="0"
                  IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,-18,0,0">
                    <Button x:Name="BtnPrev"
                            Width="42"
                            Height="42"
                            Style="{StaticResource PlayerOverlayButton}"
                            Click="BtnPrev_Click">
                        <Path Data="{StaticResource IconPreviousGeometry}"
                              Fill="White"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"/>
                    </Button>
                    <Button x:Name="BtnPlayPause"
                            Width="54"
                            Height="54"
                            Margin="9,0"
                            Style="{StaticResource PlayerOverlayButton}"
                            Click="BtnPlayPause_Click">
                        <Path x:Name="PlayPauseIcon"
                              Fill="White"
                              Stretch="Uniform"
                              Width="22"
                              Height="22"/>
                    </Button>
                    <Button x:Name="BtnNext"
                            Width="42"
                            Height="42"
                            Style="{StaticResource PlayerOverlayButton}"
                            Click="BtnNext_Click">
                        <Path Data="{StaticResource IconNextGeometry}"
                              Fill="White"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"/>
                    </Button>
                </StackPanel>

                <StackPanel Width="164"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="28,0,28,28">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource PlayerOverlayTitle}"
                               Text="No Media"
                               FontSize="13"/>
                    <TextBlock x:Name="ArtistText"
                               Style="{StaticResource PlayerOverlaySubtitle}"
                               Text="No media available"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Canvas x:Name="ArcCanvas"
                Width="240"
                Height="240"
                IsHitTestVisible="False"/>

        <Border x:Name="TimestampBadge"
                Style="{StaticResource PlayerTimestampBadge}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <TextBlock x:Name="TimestampText"
                       Foreground="White"
                       FontSize="10"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</local:PlayerControlBase>
