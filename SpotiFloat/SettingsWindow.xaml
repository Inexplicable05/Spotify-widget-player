<Window x:Class="SpotiFloat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiFloat Settings" Width="380" SizeToContent="Height"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" MouseLeftButtonDown="Window_MouseDown" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Modern Toggle Switch -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource SettingsElementBorder}" BorderThickness="1" BorderBrush="{DynamicResource SettingsElementBorder}">
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1DB954" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#1DB954" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsElementHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SettingsElementBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsElementBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsElementHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="10" Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <ContentPresenter/>
                                                <Path x:Name="Arrow" Data="M19 9l-7 7-7-7" Stroke="{DynamicResource SettingsIconForeground}" StrokeThickness="2" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" Margin="14,12,30,12" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource SettingsPopupBackground}" BorderBrush="{DynamicResource SettingsPopupBorder}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextForeground}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsElementHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsElementHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4DFFFFFF" CornerRadius="3" Margin="0,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border CornerRadius="24" Background="{DynamicResource SettingsPopupBackground}" BorderBrush="{DynamicResource SettingsPopupBorder}" BorderThickness="1" Margin="10,10,10,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/icon.ico" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="Widget Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextForeground}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="RefreshButton_Click" ToolTip="Refresh Widget" Margin="0,0,4,0">
                    <Path Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CloseButton_Click" ToolTip="Close">
                    <Path Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </Grid>
            
            <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource SettingsElementBorder}" VerticalAlignment="Bottom"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" MaxHeight="550" VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="24,24,24,24">
                    
                    <!-- Theme Selector -->
                    <TextBlock Text="THEME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SettingsIconForeground}" Margin="0,0,0,8" Opacity="0.6"/>
                    <Border CornerRadius="12" Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" BorderThickness="1" Margin="0,0,0,24" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ThemeDarkBtn" Grid.Column="0" Style="{StaticResource IconButton}" Click="ThemeBtn_Click" Tag="0" Margin="0,0,4,0" ToolTip="Dark">
                                <Path Data="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="4"/>
                            </Button>
                            <Button x:Name="ThemeLightBtn" Grid.Column="1" Style="{StaticResource IconButton}" Click="ThemeBtn_Click" Tag="1" Margin="0,0,4,0" ToolTip="Light">
                                <Path Data="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="4"/>
                            </Button>
                            <Button x:Name="ThemeGlassBtn" Grid.Column="2" Style="{StaticResource IconButton}" Click="ThemeBtn_Click" Tag="2" Margin="0,0,4,0" ToolTip="Glass">
                                <Path Data="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="4"/>
                            </Button>
                            <Button x:Name="ThemeDynamicBtn" Grid.Column="3" Style="{StaticResource IconButton}" Click="ThemeBtn_Click" Tag="3" ToolTip="Dynamic Colour — adapts to album art">
                                <Path Data="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="4"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Display Mode -->
                    <TextBlock Text="DISPLAY MODE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SettingsIconForeground}" Margin="0,0,0,8" Opacity="0.6"/>
                    <ComboBox x:Name="ZOrderComboBox" Margin="0,0,0,24" Style="{StaticResource ComboStyle}" ItemContainerStyle="{StaticResource ModernComboBoxItem}" SelectionChanged="SettingChanged" Foreground="{DynamicResource PrimaryTextForeground}" FontWeight="Medium" FontSize="14">
                        <ComboBoxItem Content="Always on Top"/>
                        <ComboBoxItem Content="On Desktop"/>
                    </ComboBox>

                    <!-- Scale -->
                    <TextBlock Text="SCALE SIZE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SettingsIconForeground}" Margin="0,0,0,8" Opacity="0.6"/>
                    <Border CornerRadius="12" Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" BorderThickness="1" Margin="0,0,0,24" Padding="16,12">
                        <Grid>
                            <TextBox x:Name="ScaleTextBox" Text="100" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextForeground}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextChanged="ScaleTextBox_TextChanged" PreviewTextInput="ScaleTextBox_PreviewTextInput" />
                            <TextBlock Text="%" Foreground="{DynamicResource SettingsIconForeground}" FontWeight="Bold" FontSize="12" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Draggable Widget -->
                    <Border CornerRadius="10" Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4 8h16M4 16h16" Stroke="{DynamicResource SettingsIconForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="0" Text="Draggable Widget" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextForeground}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="LockCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </Grid>
                    </Border>
                    
                    <!-- Hide on Fullscreen -->
                    <Border x:Name="HideFullscreenContainer" CornerRadius="10" Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" Stroke="{DynamicResource SettingsIconForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="0" Text="Hide on Fullscreen Apps" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextForeground}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="HideOnFullscreenCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </Grid>
                    </Border>
                    
                    <!-- Album Cover Fade is always active — no toggle needed -->

                    <!-- Dynamic Title Colour -->
                    <Border CornerRadius="10" Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" Stroke="{DynamicResource SettingsIconForeground}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Dynamic Title Colour" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextForeground}" FontSize="14"/>
                                    <!-- Shown when Dynamic theme is selected -->
                                    <TextBlock x:Name="DynamicTitleManagedLabel" Text="Managed by Dynamic Theme" Foreground="#1DB954" FontSize="11" Opacity="0.9" Visibility="Collapsed"/>
                                    <!-- Shown otherwise -->
                                    <TextBlock x:Name="DynamicTitleNormalLabel" Text="Song title adopts the album art's dominant colour" Foreground="{DynamicResource SettingsIconForeground}" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="DynamicTitleColourCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </Grid>
                    </Border>

                    <!-- Danger Zone -->
                    <Border CornerRadius="12" Background="#0DFF0000" BorderBrush="#33FF0000" BorderThickness="1">
                        <StackPanel>
                            <Button x:Name="DangerZoneBtn" Background="Transparent" BorderThickness="0" Foreground="White" FontWeight="Bold" Padding="16" HorizontalContentAlignment="Stretch" Click="DangerZoneBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" Stroke="#EF4444" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Danger Zone" FontSize="14"/>
                                    </StackPanel>
                                    <Path x:Name="DangerZoneIcon" Data="M19 9l-7 7-7-7" Stroke="#EF4444" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="DangerZoneContent" Visibility="Collapsed" Margin="0,0,0,0">
                                <Rectangle Height="1" Fill="#1AFF0000" Margin="0,0,0,12"/>
                                <TextBlock Text="Uninstalling will remove the widget entirely from your system. This action cannot be undone." Foreground="#EF4444" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="16,0,16,12"/>
                                <Button Content="Uninstall Widget" Background="#EF4444" Foreground="White" FontWeight="Bold" Margin="16,0,16,16" Padding="0,10" BorderThickness="0" Click="UninstallButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    
                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource SettingsElementBorder}" VerticalAlignment="Top"/>
            
            <!-- Bottom Actions -->
            <Grid Grid.Row="2" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Style="{StaticResource ActionBtn}" Click="RestoreDefaultButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3 10a8.001 8.001 0 11.954 3.799M3 10V4m0 6h6" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Reset Settings" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Grid.Column="2" Style="{StaticResource ActionBtn}" Click="ExitButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" Stroke="{DynamicResource PrimaryTextForeground}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exit App" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
