<Window x:Class="SpotiFloat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiFloat Settings" Width="400" SizeToContent="Height" MaxHeight="680"
        Icon="icon.ico" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource PrimaryTextForeground}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextForeground}"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" CornerRadius="5" Padding="4,6" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsElementHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsElementBackground}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryTextForeground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryTextForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextForeground}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsElementBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsElementBorder}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextForeground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource SettingsElementBorder}"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
    </Window.Resources>
    <Border Margin="8" Padding="20,16" CornerRadius="12" BorderThickness="1"
            Background="{DynamicResource SettingsPopupBackground}" BorderBrush="{DynamicResource SettingsPopupBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16" MouseLeftButtonDown="Window_MouseDown" Background="Transparent">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
                <Button Content="&#x2715;" Width="32" HorizontalAlignment="Right" Click="CloseButton_Click"
                        AutomationProperties.Name="Close settings" ToolTip="Close settings" IsCancel="True"/>
            </Grid>
            <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Layout"/>
                        <UniformGrid Grid.Column="1" Columns="3">
                            <RadioButton x:Name="LayoutBarBtn" Content="Bar" GroupName="Layout" Tag="0" Style="{StaticResource Choice}" Checked="LayoutChoice_Checked"/>
                            <RadioButton x:Name="LayoutSquareBtn" Content="Square" GroupName="Layout" Tag="1" Style="{StaticResource Choice}" Checked="LayoutChoice_Checked"/>
                            <RadioButton x:Name="LayoutDiskBtn" Content="Disk" GroupName="Layout" Tag="2" Style="{StaticResource Choice}" Checked="LayoutChoice_Checked"/>
                        </UniformGrid>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Theme"/>
                        <UniformGrid Grid.Column="1" Columns="4">
                            <RadioButton x:Name="ThemeDarkBtn" Content="Dark" GroupName="Theme" Tag="0" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                            <RadioButton x:Name="ThemeLightBtn" Content="Light" GroupName="Theme" Tag="1" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                            <RadioButton x:Name="ThemeGlassBtn" Content="Glass" GroupName="Theme" Tag="2" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                            <RadioButton x:Name="ThemeDynamicBtn" Content="Dynamic" GroupName="Theme" Tag="3" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                        </UniformGrid>
                    </Grid>
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Size"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="10" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="ScaleSlider_ValueChanged" AutomationProperties.Name="Widget size percent"/>
                        <TextBox x:Name="ScaleTextBox" Grid.Column="2" Padding="5" VerticalContentAlignment="Center" TextAlignment="Right"
                                 Foreground="{DynamicResource PrimaryTextForeground}" Background="{DynamicResource SettingsElementBackground}"
                                 BorderBrush="{DynamicResource SettingsElementBorder}" AutomationProperties.Name="Widget size percent"
                                 LostFocus="ScaleTextBox_LostFocus" KeyDown="ScaleTextBox_KeyDown"/>
                        <TextBlock Grid.Column="3" Text="%" HorizontalAlignment="Right"/>
                    </Grid>
                    <CheckBox x:Name="DynamicTitleColourCheckBox" Content="Album-coloured title" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock x:Name="DynamicTitleHint" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}" Margin="20,0,0,0"/>
                    <Separator/>
                    <TextBlock Text="Behavior" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="162"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Window position"/>
                        <UniformGrid Grid.Column="1" Columns="2">
                            <RadioButton x:Name="ZOrderTopmostChoice" Content="On top" GroupName="Position" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                            <RadioButton x:Name="ZOrderDesktopChoice" Content="Desktop" GroupName="Position" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                        </UniformGrid>
                    </Grid>
                    <CheckBox x:Name="LockCheckBox" Content="Lock position" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="HideOnFullscreenCheckBox" Content="Hide during fullscreen" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="RunOnStartupCheckBox" Content="Start with Windows" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <Separator/>
                    <Expander x:Name="AdvancedExpander" Header="Advanced" Foreground="{DynamicResource PrimaryTextForeground}">
                        <StackPanel Margin="0,12,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="Refresh media" Click="RefreshButton_Click" Margin="0,0,6,0"/>
                                <Button Content="Reset settings" Click="RestoreDefaultButton_Click"/>
                            </UniformGrid>
                            <TextBlock Text="Clear saved preferences and startup registration, then exit. The app files remain on your device."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}" Margin="0,12,0,8"/>
                            <Button Content="Clear data and exit…" Click="UninstallButton_Click" HorizontalAlignment="Left"/>
                            <Grid Margin="0,12,0,0">
                                <Button Content="GitHub" Click="GitHubBtn_Click" HorizontalAlignment="Left"/>
                                <Button Content="Exit app" Click="ExitButton_Click" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Changes save automatically" FontSize="12" Margin="0,16,0,0"
                       Foreground="{DynamicResource SecondaryTextForeground}"/>
        </Grid>
    </Border>
</Window>
