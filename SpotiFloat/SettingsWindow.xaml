<Window x:Class="SpotiFloat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiFloat Settings" Width="384" SizeToContent="Height" MaxHeight="720"
        Icon="icon.ico" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource PrimaryTextForeground}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SpotiFloat;component/Controls/SettingsResources.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Border Margin="8" CornerRadius="18" BorderThickness="1" Background="{DynamicResource SettingsPopupBackground}" BorderBrush="{DynamicResource SettingsPopupBorder}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SettingsElementBorder}" Padding="18,12">
                <Grid Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/>
                    <Button x:Name="CloseSettingsButton" Content="&#x2715;" Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                            Click="CloseButton_Click" AutomationProperties.Name="Close settings" ToolTip="Close settings" IsCancel="True"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,12,18,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource SettingsElementBackground}" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RefreshMediaButton" Width="30" Height="30" Padding="6" Click="RefreshButton_Click"
                                        AutomationProperties.Name="Refresh media" ToolTip="Refresh media">
                                    <Path Data="M21,11 A9,9 0 0 0 5,6 L3,8 M3,3 L3,8 L8,8 M3,13 A9,9 0 0 0 19,18 L21,16 M16,16 L21,16 L21,21"
                                          Stroke="{DynamicResource SettingsIconForeground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="ExitAppButton" Width="30" Height="30" Padding="6" Click="ExitButton_Click"
                                        AutomationProperties.Name="Exit app" ToolTip="Exit app">
                                    <Path Data="M18.36,6.64 A9,9 0 1 1 5.64,6.64 M12,2 L12,12" Stroke="{DynamicResource SettingsIconForeground}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Layout"/>
                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                            <UniformGrid Columns="3" AutomationProperties.Name="Layout">
                                <RadioButton x:Name="LayoutBarBtn" Content="Bar" GroupName="Layout" Tag="0" Style="{StaticResource Choice}" Checked="LayoutChoice_Checked"/>
                                <RadioButton x:Name="LayoutSquareBtn" Content="Square" GroupName="Layout" Tag="1" Style="{StaticResource Choice}" Checked="LayoutChoice_Checked"/>
                                <RadioButton x:Name="LayoutDiskBtn" Content="Disk" GroupName="Layout" Tag="2" Style="{StaticResource Choice}" Checked="LayoutChoice_Checked"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Theme"/>
                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                            <UniformGrid Columns="3" AutomationProperties.Name="Theme">
                                <RadioButton x:Name="ThemeDarkBtn" Content="Dark" GroupName="Theme" Tag="0" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                                <RadioButton x:Name="ThemeLightBtn" Content="Light" GroupName="Theme" Tag="1" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                                <RadioButton x:Name="ThemeGlassBtn" Content="Glass" GroupName="Theme" Tag="2" Style="{StaticResource Choice}" Checked="ThemeChoice_Checked"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <TextBlock Text="Album colouring" Margin="0,14,0,7"/>
                    <Border Style="{StaticResource SegmentGroup}">
                        <UniformGrid Columns="4" AutomationProperties.Name="Album colouring">
                            <RadioButton x:Name="ColourOffBtn" Content="Off" GroupName="AlbumColour" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                            <RadioButton x:Name="ColourTitleBtn" Content="Title" GroupName="AlbumColour" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                            <RadioButton x:Name="ColourAccentsBtn" Content="Accents" GroupName="AlbumColour" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                            <RadioButton x:Name="ColourFullBtn" Content="Full" GroupName="AlbumColour" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="AlbumColourHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <Grid Margin="0,14,0,3">
                        <TextBlock Text="Size"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset" FontSize="11" Foreground="{DynamicResource SecondaryTextForeground}" Click="ResetSize_Click"
                                    AutomationProperties.Name="Reset size to 100 percent" ToolTip="Reset size to 100%"/>
                            <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource SettingsElementBorder}" Background="{DynamicResource SettingsElementBackground}" Padding="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ScaleTextBox" Width="34" VerticalContentAlignment="Center" TextAlignment="Right" Padding="0"
                                             Foreground="{DynamicResource PrimaryTextForeground}" Background="Transparent" AutomationProperties.Name="Widget size percent"
                                             LostFocus="ScaleTextBox_LostFocus" KeyDown="ScaleTextBox_KeyDown"/>
                                    <TextBlock Text="%" Margin="1,0,2,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="ScaleSlider" Minimum="10" Maximum="300" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                            ValueChanged="ScaleSlider_ValueChanged" AutomationProperties.Name="Widget size percent"/>
                    <Grid Margin="4,0,4,0"><TextBlock Text="10%" Style="{StaticResource Hint}" FontSize="10.5"/><TextBlock Text="300%" HorizontalAlignment="Right" Style="{StaticResource Hint}" FontSize="10.5"/></Grid>
                    <Separator Margin="0,12"/>
                    <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Window position"/>
                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                            <UniformGrid Columns="2" AutomationProperties.Name="Window position">
                                <RadioButton x:Name="ZOrderTopmostChoice" Content="On top" GroupName="Position" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                                <RadioButton x:Name="ZOrderDesktopChoice" Content="Desktop" GroupName="Position" Style="{StaticResource Choice}" Checked="SettingChanged"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <CheckBox x:Name="LockCheckBox" Content="Lock position" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="HideOnFullscreenCheckBox" Content="Hide during fullscreen" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="RunOnStartupCheckBox" Content="Start with Windows" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,10,0,0" Padding="10,8">
                        <Expander x:Name="AdvancedExpander" Header="Advanced" Foreground="{DynamicResource SecondaryTextForeground}" FontSize="12">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Clear preferences and startup registration, then exit. App files remain installed." Style="{StaticResource Hint}"/>
                                <Button x:Name="ClearDataButton" Content="Clear data and exit&#x2026;" Click="ClearDataAndExit_Click" Foreground="{DynamicResource SettingsDanger}"
                                        BorderBrush="{DynamicResource SettingsElementBorder}" HorizontalAlignment="Left" Margin="0,8,0,14"/>
                                <Button x:Name="UninstallAppButton" Content="Uninstall SpotiFloat&#x2026;" Click="UninstallButton_Click" Foreground="{DynamicResource SettingsDanger}"
                                        BorderBrush="{DynamicResource SettingsElementBorder}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="UninstallHint" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
                                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="18,9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SettingsElementBorder}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Changes save automatically" FontSize="10.5" Foreground="{DynamicResource SecondaryTextForeground}" Margin="0,0,8,0"/>
                    <Button x:Name="GitHubProfileButton" Grid.Column="1" Click="GitHubBtn_Click" FontSize="10.5" Foreground="{DynamicResource SecondaryTextForeground}"
                            Background="{DynamicResource SettingsElementBackground}" BorderBrush="{DynamicResource SettingsElementBorder}" MinHeight="26" Padding="7,4"
                            AutomationProperties.Name="Open inexplicable05 on GitHub" ToolTip="Open GitHub profile">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12,0.297 C5.37,0.297 0,5.67 0,12.297 C0,17.6 3.438,22.098 8.205,23.683 C8.805,23.796 9.025,23.425 9.025,23.106 L9.025,20.866 C5.687,21.59 4.983,19.45 4.983,19.45 C4.437,18.063 3.65,17.693 3.65,17.693 C2.563,16.949 3.734,16.964 3.734,16.964 C4.939,17.048 5.573,18.201 5.573,18.201 C6.643,20.036 8.382,19.506 9.068,19.199 C9.176,18.423 9.485,17.894 9.828,17.594 C7.163,17.291 4.362,16.262 4.362,11.664 C4.362,10.354 4.827,9.284 5.597,8.444 C5.462,8.141 5.062,6.921 5.702,5.268 C5.702,5.268 6.707,4.946 9.002,6.498 C9.962,6.231 10.982,6.099 12.002,6.094 C13.022,6.099 14.042,6.232 15.002,6.498 C17.282,4.946 18.287,5.268 18.287,5.268 C18.932,6.921 18.527,8.141 18.407,8.444 C19.172,9.284 19.637,10.354 19.637,11.664 C19.637,16.274 16.832,17.289 14.162,17.586 C14.582,17.946 14.972,18.682 14.972,19.806 L14.972,23.106 C14.972,23.421 15.182,23.796 15.797,23.676 C20.565,22.092 24,17.592 24,12.297 C24,5.67 18.627,0.297 12,0.297 Z"/>
                            <TextBlock Text="Made by inexplicable05"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
