<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">
    <!-- Dark Theme (Current Default) -->
    <SolidColorBrush x:Key="AppBackground" Color="#181818" />
    <SolidColorBrush x:Key="AppBorder" Color="Transparent" />
    <SolidColorBrush x:Key="AlbumArtBackground" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AlbumArtBorder" Color="#14FFFFFF" />
    
    <SolidColorBrush x:Key="PrimaryTextForeground" Color="White" />
    <SolidColorBrush x:Key="SecondaryTextForeground" Color="#B3B3B3" />
    
    <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" />
    <!-- Settings UI Colors -->
    <SolidColorBrush x:Key="SettingsPopupBackground" Color="#171717" />
    <SolidColorBrush x:Key="SettingsPopupBorder" Color="#262626" />
    <SolidColorBrush x:Key="SettingsElementBackground" Color="#0DFFFFFF" /> <!-- White/5 -->
    <SolidColorBrush x:Key="SettingsElementHover" Color="#1AFFFFFF" /> <!-- White/10 -->
    <SolidColorBrush x:Key="SettingsElementBorder" Color="#1AFFFFFF" /> <!-- White/10 -->
    <SolidColorBrush x:Key="SettingsIconForeground" Color="#B3FFFFFF" /> <!-- White/70 -->
    
    <SolidColorBrush x:Key="ButtonIconForeground" Color="White" />
    
    <SolidColorBrush x:Key="SliderTrackBackground" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackHover" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="SliderThumb" Color="White" />
    
    <SolidColorBrush x:Key="TooltipBackground" Color="#282828" />
    <SolidColorBrush x:Key="TooltipForeground" Color="White" />
    
    <System:Double x:Key="WindowShadowOpacity">0.4</System:Double>
</ResourceDictionary>
