<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">
    <!-- Light Theme -->
    <SolidColorBrush x:Key="AppBackground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AppBorder" Color="Transparent" />
    <SolidColorBrush x:Key="AlbumArtBackground" Color="#1A000000" />
    <SolidColorBrush x:Key="AlbumArtBorder" Color="#14000000" />
    
    <SolidColorBrush x:Key="PrimaryTextForeground" Color="#111111" />
    <SolidColorBrush x:Key="SecondaryTextForeground" Color="#666666" />
    
    <SolidColorBrush x:Key="ButtonBackground" Color="#14000000" />
    <!-- Settings UI Colors -->
    <SolidColorBrush x:Key="SettingsPopupBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsPopupBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="SettingsElementBackground" Color="#0D000000" /> <!-- Black/5 -->
    <SolidColorBrush x:Key="SettingsElementHover" Color="#1A000000" /> <!-- Black/10 -->
    <SolidColorBrush x:Key="SettingsElementBorder" Color="#1A000000" /> <!-- Black/10 -->
    <SolidColorBrush x:Key="SettingsIconForeground" Color="#B3000000" /> <!-- Black/70 -->
    <SolidColorBrush x:Key="ButtonIconForeground" Color="#333333" />
    
    <SolidColorBrush x:Key="SliderTrackBackground" Color="#22000000" />
    <SolidColorBrush x:Key="SliderTrackHover" Color="#44000000" />
    <SolidColorBrush x:Key="SliderThumb" Color="#333333" />
    
    <SolidColorBrush x:Key="TooltipBackground" Color="#E5E5E5" />
    <SolidColorBrush x:Key="TooltipForeground" Color="#111111" />
    
    <System:Double x:Key="WindowShadowOpacity">0.2</System:Double>
</ResourceDictionary>
